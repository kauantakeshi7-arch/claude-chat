# Chave da API do Claude (https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

# Segredo para assinar os tokens de sessão (qualquer string aleatória longa)
JWT_SECRET=troque-por-uma-string-aleatoria-longa-aqui

# Usuários separados por vírgula no formato usuario:senha
# Exemplo: tanik:minhasenha123,amigo:senhadoamigo456
AUTH_USERS=tanik:suasenha,amigo:senhadoamigo
